{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AppDbConnectionStrings": "server=localhost;userid=root;Password=root;database=InprovePlan",
    "RedisConnection": "127.0.0.1:6379,password=InprovePlanPassword,abortConnect=false,connectTimeout=5000,syncTimeout=3000"
  },
  "JwtSettings": {
    "Issuer": "JackChey",
    "Audience": "user",
    "Secret": "lQm7ZtWJBNyaEiVnkHTUgMGw7HIMSyKKqARsgTlECRfC5dNDIAEVmy2GOBKB3eWC",
    "AccessTokenExpirationMinutes": 30
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "InprovePlan.Controllers": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddlewareImpl": "Fatal",
        "ZiggyCreatures.Caching.Fusion": "Fatal"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "InprovePlan.Api",
      "Environment": "Production"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.ndjson",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Cache": {
    "AppName": "InprovePlan",
    "Environment": "prod",
    "KeyVersion": "v1",
    "DefaultDurationSeconds": 300,
    "NullValueDurationSeconds": 60,
    "JitterMaxSeconds": 30
  },
  "Idempotency": {
    "HeaderName": "Idempotency-Key",
    "ExpirationHours": 24,
    "LockSeconds": 30
  },
  "Run_Environment": "Development",
  "PrometheusSettings": {
    "IP": "localhost",
    "Port": 9090,
    "TimeoutSeconds": 5,
    "HttpDurationBucketMetric": "http_request_duration_seconds_bucket",
    "FailFastOnMetricMissing": false
  },
  "Snowflake": {
    "WorkerId": 1
  },
  "AllowedHosts": "*"
}
