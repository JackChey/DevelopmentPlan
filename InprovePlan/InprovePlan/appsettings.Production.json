{
  "Cache": {
    "Environment": "prod"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "PrometheusSettings": {
    "Port": 9090,
    "TimeoutSeconds": 3
  }
}